<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app is signed with the hardened runtime. Without this, macOS refuses the microphone
       without asking and Booth never appears under Privacy & Security > Microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
