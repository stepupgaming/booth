{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Booth",
  "version": "0.1.0",
  "identifier": "com.nofacetube.booth",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Booth",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#07080D",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/NoFaceTube/Booth/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
